/// 仕入実績と手配の両方に登場する材料の分類ディメンション。材料番号は一意。
/// 両方を含めないと、手配にしか無い546件がスライサで空白になる。
/// Oracle は大文字小文字を区別するが Power BI は区別しないため、UPPER でまとめる
/// (AVSS05Br-B と AVSS05BR-B のような表記ゆれが3組ある)。
/// 対象区分: 製品に組み込まれる部材か否か。参照エクセルの集計対象と一致する。
/// 部材以外＝工場消耗品・梱包材料・ダミー・その他原材料/完成品・分類なし・ハーネス系・
/// バッテリーCABLE・圧着機パーツ・９９９。製品に組み込まれない品目を指す。
/// 除外は固定せず、この列をスライサで制御する。
table 材料分類
	lineageTag: 60718293-a4b5-46c7-d8e9-f0a1b2c3d4e5

	column 材料番号
		dataType: string
		lineageTag: 60718293-a4b5-46c7-d8e9-f0a1b2c3d300
		summarizeBy: none
		sourceColumn: 材料番号

		annotation SummarizationSetBy = Automatic

	column 分類名
		dataType: string
		lineageTag: 60718293-a4b5-46c7-d8e9-f0a1b2c3d301
		summarizeBy: none
		sourceColumn: 分類名

		annotation SummarizationSetBy = Automatic

	column 電線区分
		dataType: string
		lineageTag: 60718293-a4b5-46c7-d8e9-f0a1b2c3d302
		summarizeBy: none
		sourceColumn: 電線区分

		annotation SummarizationSetBy = Automatic

	column 部材区分
		dataType: string
		lineageTag: 60718293-a4b5-46c7-d8e9-f0a1b2c3d303
		summarizeBy: none
		sourceColumn: 対象区分

		annotation SummarizationSetBy = Automatic

	partition 材料分類 = m
		mode: import
		source =
				let
				    ソース = Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"),
				    結果 = Value.NativeQuery(ソース, "WITH ml AS (SELECT mat FROM (SELECT DISTINCT TRIM(F_品目番号) AS mat FROM PRONES.TB_仕入実績情報 WHERE F_勘定年月 >= '2025/01' UNION SELECT DISTINCT TRIM(F_材料番号) AS mat FROM PRONES.TB_材料手配残情報 WHERE F_手配日 >= '2025/01/01') WHERE mat IS NOT NULL), mc AS (SELECT TRIM(m.F_材料番号) AS mat, NVL(TRIM(c.F_分類名),'(分類なし)') AS bunrui FROM PRONES.TB_材料情報 m LEFT JOIN PRONES.TB_品目分類情報 c ON TRIM(c.F_番号)=TRIM(m.F_品目分類)), j AS (SELECT MAX(ml.mat) AS mat, MAX(NVL(mc.bunrui,'(分類なし)')) AS bunrui FROM ml LEFT JOIN mc ON mc.mat=ml.mat GROUP BY UPPER(ml.mat)) SELECT j.mat AS 材料番号, j.bunrui AS 分類名, CASE WHEN j.bunrui IN ('電線材料','電線類') THEN '電線' ELSE '電線以外' END AS 電線区分, CASE WHEN j.bunrui IN ('(分類なし)','その他原材料','その他完成品','ダミー','ハーネス（切断）','ハ－ネス(雑品)','バッテリーCABLE','圧着機パ－ツ','工場消耗品','梱包材料','９９９') THEN '部材以外' ELSE '部材' END AS 対象区分 FROM j")
				in
				    結果

	annotation PBI_ResultType = Table

