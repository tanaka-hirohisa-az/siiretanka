/// 手配データ(PRONES.TB_材料手配残情報)から算出した単価変動の先行検知用テーブル。
/// 転記には使わない。転記は 仕入実績_影響額_月次 を使う。
/// 手配日は発注日、仕入実績の勘定年月は計上月であり、中央値で1か月ずれる。
/// 2%超の単価変動を両データが捉えた781組では、手配が先行60.6%・同月32.8%・遅行6.7%。
/// 一方で月次の影響額は実績と最大60%ずれ、未完納(2026/01-07で手配額の17.3%)も含むため
/// 金額そのものは参考値。計算ルールは実績側と完全に同一に揃えてある。
/// 外貨建ては全体の0.02%しかないため為替換算は行わない(手配単価をそのまま使う)。
table 手配_影響額_月次
	lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d8e9f1

	measure 影響額_合計_手配 =
			SUM ( '手配_影響額_月次'[影響額] )
		formatString: #,0
		lineageTag: 4e5f6071-8293-43a4-b5c6-d7e8f9a0b101

	measure 影響額_値上げのみ_手配 =
			CALCULATE (
			    SUM ( '手配_影響額_月次'[影響額] ),
			    '手配_影響額_月次'[単価差] > 0
			)
		formatString: #,0
		lineageTag: 4e5f6071-8293-43a4-b5c6-d7e8f9a0b102

	measure 影響額_値下げのみ_手配 =
			CALCULATE (
			    SUM ( '手配_影響額_月次'[影響額] ),
			    '手配_影響額_月次'[単価差] < 0
			)
		formatString: #,0
		lineageTag: 4e5f6071-8293-43a4-b5c6-d7e8f9a0b103

	measure 手配額_合計 =
			SUM ( '手配_影響額_月次'[手配額] )
		formatString: #,0
		lineageTag: 4e5f6071-8293-43a4-b5c6-d7e8f9a0b104

	measure 値上げ率_手配 =
			DIVIDE ( [影響額_値上げのみ_手配], [手配額_合計] )
		formatString: 0.0%
		lineageTag: 4e5f6071-8293-43a4-b5c6-d7e8f9a0b105

	measure 上昇検知件数 =
			// 当月に単価が上がった材料×仕入先×倉庫の件数。実績より先に立つ。
			CALCULATE (
			    COUNTROWS ( '手配_影響額_月次' ),
			    '手配_影響額_月次'[変動区分] = "前月比 上昇"
			)
		formatString: #,0
		lineageTag: 4e5f6071-8293-43a4-b5c6-d7e8f9a0b106

	column 年月
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d800a
		summarizeBy: none
		sourceColumn: 年月

		annotation SummarizationSetBy = Automatic

	column 年月日
		dataType: dateTime
		formatString: yyyy/mm
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d801a
		summarizeBy: none
		sourceColumn: 年月日

		annotation SummarizationSetBy = Automatic

	column 材料番号
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d802a
		summarizeBy: none
		sourceColumn: 材料番号

		annotation SummarizationSetBy = Automatic

	column 仕入先番号
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d803a
		summarizeBy: none
		sourceColumn: 仕入先番号

		annotation SummarizationSetBy = Automatic

	column 倉庫番号
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d804a
		summarizeBy: none
		sourceColumn: 倉庫番号

		annotation SummarizationSetBy = Automatic

	column 基準単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d805a
		summarizeBy: none
		sourceColumn: 基準単価

		annotation SummarizationSetBy = Automatic

	column 当月単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d806a
		summarizeBy: none
		sourceColumn: 当月単価

		annotation SummarizationSetBy = Automatic

	column 前月単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d807a
		summarizeBy: none
		sourceColumn: 前月単価

		annotation SummarizationSetBy = Automatic

	column 単価差
		dataType: double
		formatString: #,0.000000
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d808a
		summarizeBy: none
		sourceColumn: 単価差

		annotation SummarizationSetBy = Automatic

	column 数量
		dataType: double
		formatString: #,0
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d809a
		summarizeBy: none
		sourceColumn: 数量

		annotation SummarizationSetBy = Automatic

	column 手配額
		dataType: double
		formatString: #,0
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d810a
		summarizeBy: none
		sourceColumn: 手配額

		annotation SummarizationSetBy = Automatic

	column 影響額
		dataType: double
		formatString: #,0
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d811a
		summarizeBy: none
		sourceColumn: 影響額

		annotation SummarizationSetBy = Automatic

	column 変動区分
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d812a
		summarizeBy: none
		sourceColumn: 変動区分

		annotation SummarizationSetBy = Automatic

	column 異常値区分
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d813a
		summarizeBy: none
		sourceColumn: 異常値区分

		annotation SummarizationSetBy = Automatic

	column 基準区分
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d814a
		summarizeBy: none
		sourceColumn: 基準区分

		annotation SummarizationSetBy = Automatic

	column 基準年月
		dataType: string
		lineageTag: 2c3d4e5f-6071-4182-9394-a5b6c7d815a
		summarizeBy: none
		sourceColumn: 基準年月

		annotation SummarizationSetBy = Automatic

	partition 手配_影響額_月次 = m
		mode: import
		source =
				let
				    ソース = Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"),
				    結果 = Value.NativeQuery(ソース, "WITH w AS (SELECT TRIM(F_材料番号) AS mat, TRIM(F_指示先番号) AS sup, TRIM(F_在庫場所) AS wh, SUBSTR(F_手配日,1,7) AS ym, SUM(F_手配数) AS q, SUM(F_手配単価*F_手配数) AS amt FROM PRONES.TB_材料手配残情報 WHERE F_手配日 >= '2025/01/01' AND NVL(F_手配単価,0)>0 AND NVL(F_手配数,0)>0 GROUP BY TRIM(F_材料番号), TRIM(F_指示先番号), TRIM(F_在庫場所), SUBSTR(F_手配日,1,7)), wm AS (SELECT w.*, SUM(q) OVER (PARTITION BY mat, sup, ym) AS mq, SUM(amt) OVER (PARTITION BY mat, sup, ym) AS mamt FROM w), mo AS (SELECT DISTINCT mat, sup, ym, mq, mamt, mamt/mq AS upx FROM wm WHERE mq<>0), mol AS (SELECT mo.*, LAG(upx) OVER (PARTITION BY mat, sup ORDER BY ym) AS prev FROM mo), b AS (SELECT mat, sup, NVL(MAX(CASE WHEN ym LIKE '2025%' THEN ym END), MIN(ym)) AS bym, COUNT(CASE WHEN ym LIKE '2025%' THEN 1 END) AS mc25, CASE WHEN MAX(CASE WHEN ym LIKE '2025%' THEN ym END) IS NOT NULL THEN '前年最終月' ELSE '当年初回' END AS bkind FROM mo GROUP BY mat, sup), bx AS (SELECT b.mat, b.sup, b.bym, b.bkind, b.mc25, p.upx AS bpx, p.mq AS bq FROM b JOIN mo p ON p.mat=b.mat AND p.sup=b.sup AND p.ym=b.bym) SELECT x.ym AS 年月, TO_DATE(x.ym||'/01','YYYY/MM/DD') AS 年月日, x.mat AS 材料番号, x.sup AS 仕入先番号, x.wh AS 倉庫番号, ROUND(bx.bpx,6) AS 基準単価, ROUND(m.upx,6) AS 当月単価, ROUND(m.prev,6) AS 前月単価, ROUND(m.upx - bx.bpx,6) AS 単価差, x.q AS 数量, x.amt AS 手配額, ROUND((m.upx - bx.bpx)*x.q,2) AS 影響額, CASE WHEN m.prev IS NULL THEN '初回' WHEN ABS(m.upx-m.prev) <= 0.000001 THEN '据置' WHEN m.upx > m.prev THEN '前月比 上昇' ELSE '前月比 下降' END AS 変動区分, CASE WHEN bx.mc25=1 AND bx.bkind='前年最終月' AND bx.bq<5 THEN '試作基準' WHEN m.upx > bx.bpx*3 OR m.upx < bx.bpx/3 THEN '比率乖離' ELSE '対象' END AS 異常値区分, bx.bkind AS 基準区分, bx.bym AS 基準年月 FROM wm x JOIN mol m ON m.mat=x.mat AND m.sup=x.sup AND m.ym=x.ym JOIN bx ON bx.mat=x.mat AND bx.sup=x.sup WHERE x.ym >= '2026/01' AND x.mq<>0 AND bx.bpx<>0")
				in
				    結果

	annotation PBI_ResultType = Table
