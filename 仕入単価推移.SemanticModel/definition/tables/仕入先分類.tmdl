/// 仕入先マスタ。影響額を仕入先別に見るためのディメンション。
table 仕入先分類
	lineageTag: 718293a4-b5c6-47d8-e9f0-a1b2c3d4e5f6

	column 仕入先番号
		dataType: string
		lineageTag: 718293a4-b5c6-47d8-e9f0-a1b2c3d4e400
		summarizeBy: none
		sourceColumn: 仕入先番号

		annotation SummarizationSetBy = Automatic

	column 仕入先名称
		dataType: string
		lineageTag: 718293a4-b5c6-47d8-e9f0-a1b2c3d4e401
		summarizeBy: none
		sourceColumn: 仕入先名称

		annotation SummarizationSetBy = Automatic

	partition 仕入先分類 = m
		mode: import
		source =
				let
				    ソース = Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"),
				    結果 = Value.NativeQuery(ソース, "SELECT TRIM(F_仕入先番号) AS 仕入先番号, TRIM(F_仕入先名称) AS 仕入先名称 FROM PRONES.TB_仕入先情報 WHERE TRIM(F_仕入先番号) IS NOT NULL")
				in
				    結果

	annotation PBI_ResultType = Table
