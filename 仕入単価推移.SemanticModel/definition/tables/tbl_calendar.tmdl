	/// 仕入実績が存在する最終月までを 1、それ以降を 0 とする。
	/// 8月以降のように実績が未着の月は、単価を直近から引き継ぎ稼働量を固定して
	/// 「今の水準が続いた場合」の見込み値を出しているため、実績と区別する必要がある。
	column 実績月フラグ =
			// 最終仕入月は1行テーブル データ基準 で一度だけ求め、ここではそれを読む。
			// 比較は「月」単位で行う。日付で比較すると最終仕入日(例:7/30)以降の
			// 7/31 だけがフラグ0になり、同じ月が実績と見込みに割れてしまう。
			VAR __CurMonth = EOMONTH ( 'tbl_calendar'[Date], -1 ) + 1
			RETURN
			    IF (
			        __CurMonth <= MAXX ( 'データ基準', 'データ基準'[最終仕入月] ),
			        1,
			        0
			    )
		dataType: int64
		formatString: 0
		lineageTag: 3a7b1c2d-4e5f-4061-8273-9a4b5c6d7e91
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// 月軸の表示用。実績が未着の月には (見込) を付ける。
	/// 転記時に実績と見込みを取り違えないよう、列見出しそのものに印を出す。
	column 年月_表示 =
			'tbl_calendar'[年月_yy年MM月]
			    & IF ( 'tbl_calendar'[実績月フラグ] = 0, "(見込)", "" )
		dataType: string
		lineageTag: 3a7b1c2d-4e5f-4061-8273-9a4b5c6d7e92
		summarizeBy: none
		sortByColumn: 年月_数値

		annotation SummarizationSetBy = Automatic

