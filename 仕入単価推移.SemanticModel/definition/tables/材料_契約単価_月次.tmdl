	column 加重平均単価 =
			LOOKUPVALUE (
			    '材料_加重平均単価_月次'[加重平均単価],
			    '材料_加重平均単価_月次'[F_材料番号], [F_材料番号],
			    '材料_加重平均単価_月次'[F_開始月], [F_開始月]
			)
		dataType: double
		formatString: #,0.00
		lineageTag: f1a2b3c4-d5e6-4f80-9192-a3b4c5d6e7f9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 月内仕入数 =
			LOOKUPVALUE (
			    '材料_加重平均単価_月次'[月内仕入数],
			    '材料_加重平均単価_月次'[F_材料番号], [F_材料番号],
			    '材料_加重平均単価_月次'[F_開始月], [F_開始月]
			)
		dataType: double
		formatString: #,0.00
		lineageTag: f5e6f7a8-b9c0-43c4-d536-e7f8a9b0c1dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 月内仕入金額 =
			LOOKUPVALUE (
			    '材料_加重平均単価_月次'[月内仕入金額],
			    '材料_加重平均単価_月次'[F_材料番号], [F_材料番号],
			    '材料_加重平均単価_月次'[F_開始月], [F_開始月]
			)
		dataType: double
		formatString: #,0.00
		lineageTag: f6f7a8b9-c0d1-44d5-e647-f8a9b0c1d2ee
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 契約単価_年度基準 =
			// 年初来影響の基準: その年の最初の行の前月契約単価(≒前年末水準)
			VAR __mat = '材料_契約単価_月次'[F_材料番号]
			VAR __y = YEAR ( '材料_契約単価_月次'[F_開始月] )
			VAR __firstM =
			    MINX (
			        FILTER (
			            '材料_契約単価_月次',
			            '材料_契約単価_月次'[F_材料番号] = __mat
			                && YEAR ( '材料_契約単価_月次'[F_開始月] ) = __y
			        ),
			        '材料_契約単価_月次'[F_開始月]
			    )
			RETURN
			    LOOKUPVALUE (
			        '材料_契約単価_月次'[契約単価_前月契約単価],
			        '材料_契約単価_月次'[F_材料番号], __mat,
			        '材料_契約単価_月次'[F_開始月], __firstM
			    )
		dataType: double
		formatString: #,0.00
		lineageTag: 3e6a8c0d-7f2b-4567-e8b0-1d4f6a8c0e2b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 契約単価_年初来値上げ額 =
			IF (
			    NOT ISBLANK ( [契約単価_年度基準] ),
			    '材料_契約単価_月次'[契約単価] - [契約単価_年度基準]
			)
		dataType: double
		formatString: #,0.00
		lineageTag: 4f7b9d1e-8a3c-4678-f9c1-2e5a7b9d1f3c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 契約単価_年初来影響額 =
			IF (
			    NOT ISBLANK ( [契約単価_年初来値上げ額] ),
			    [契約単価_年初来値上げ額] * '材料_契約単価_月次'[契約単価_直近12か月稼働量]
			)
		dataType: double
		formatString: #,0.00
		lineageTag: 5a8c0e2f-9b4d-4789-a0d2-3f6b8c0e2a4d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 契約差額 =
			// 契約どおり買えているか: 実績加重平均単価 − 契約単価
			// 当月に仕入が無い月は空白のままにする(契約単価との差を装わないため)
			IF (
			    NOT ISBLANK ( [加重平均単価] ),
			    [加重平均単価] - '材料_契約単価_月次'[契約単価]
			)
		dataType: double
		formatString: #,0.00
		lineageTag: 9a1b2c3d-4e5f-4a6b-8c7d-1e2f3a4b5c60
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 契約差率 = DIVIDE ( [契約差額], '材料_契約単価_月次'[契約単価] )
		dataType: double
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a1b2c3d-4e5f-4a6b-8c7d-1e2f3a4b5c61
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 材料_契約単価_月次 = calculated
		mode: import
		source = ```
				
				VAR __Rev0 =
				    FILTER (
				        'TB_材料仕入先単価情報',
				        NOT ISBLANK ( 'TB_材料仕入先単価情報'[F_材料番号] )
				            && NOT ISBLANK ( 'TB_材料仕入先単価情報'[F_開始日] )
				            && NOT ISBLANK ( 'TB_材料仕入先単価情報'[F_契約単価] )
				    )
				
				VAR __Rev1 =
				    SELECTCOLUMNS (
				        __Rev0,
				        "__材料番号",
				            TRIM (
				                SUBSTITUTE (
				                    'TB_材料仕入先単価情報'[F_材料番号],
				                    UNICHAR ( 12288 ),
				                    " "
				                )
				            ) & "",
				        "__仕入先", 'TB_材料仕入先単価情報'[F_仕入先番号] & "",
				        "__開始月",
				            EOMONTH ( 'TB_材料仕入先単価情報'[F_開始日], -1 ) + 1,
				        "__単価", 'TB_材料仕入先単価情報'[F_契約単価]
				    )
				
				VAR __MatSet =
				    FILTER (
				        DISTINCT (
				            SELECTCOLUMNS (
				                '材料情報',
				                "__材料番号",
				                    TRIM (
				                        SUBSTITUTE (
				                            '材料情報'[F_材料番号],
				                            UNICHAR ( 12288 ),
				                            " "
				                        )
				                    ) & ""
				            )
				        ),
				        [__材料番号] <> ""
				    )
				
				VAR __Rev =
				    NATURALINNERJOIN ( __Rev1, __MatSet )
				
				// 年内は12月まで行を作る。実績が未着の月は単価を引き継ぎ、
				// 稼働量は データ基準 の最終仕入月で固定した値を使う。
				// 旧: EOMONTH(TODAY(),-1) で前月末止まりだったため、8月以降が空欄になり
				//     Excel転記用ピボットで材料実績だけが埋まる歯抜けが生じていた。
				VAR __MaxM =
				    DATE ( YEAR ( MAXX ( 'データ基準', 'データ基準'[最終仕入月] ) ), 12, 1 )
				
				// 月次スパインの開始を2018年1月にクランプ(それ以前の改定はキャリーインで単価に反映される)
				VAR __MinM0 =
				    MINX ( __Rev, [__開始月] )
				
				VAR __MinM =
				    IF ( __MinM0 < DATE ( 2018, 1, 1 ), DATE ( 2018, 1, 1 ), __MinM0 )
				
				VAR __Combo =
				    GROUPBY (
				        __Rev,
				        [__材料番号],
				        [__仕入先],
				        "__初月", MINX ( CURRENTGROUP (), [__開始月] )
				    )
				
				VAR __AllMonths =
				    SELECTCOLUMNS (
				        GENERATESERIES ( 0, DATEDIFF ( __MinM, __MaxM, MONTH ), 1 ),
				        "__月", EDATE ( __MinM, [Value] )
				    )
				
				VAR __ComboMonth =
				    FILTER (
				        CROSSJOIN ( __Combo, __AllMonths ),
				        [__月] >= [__初月]
				    )
				
				// 仕入先ごとに「最終改定月|単価」の固定桁テキストを作る。
				// 後段で文字列MAXを取ると、最新改定の単価(同月改定なら高い方)が選ばれる
				VAR __ComboPrice =
				    ADDCOLUMNS (
				        __ComboMonth,
				        "__適用K",
				            VAR k1 = [__材料番号]
				            VAR k2 = [__仕入先]
				            VAR m  = [__月]
				            VAR lastRev =
				                MAXX (
				                    FILTER (
				                        __Rev,
				                        [__材料番号] = k1
				                            && [__仕入先] = k2
				                            && [__開始月] <= m
				                    ),
				                    [__開始月]
				                )
				            VAR p =
				                MAXX (
				                    FILTER (
				                        __Rev,
				                        [__材料番号] = k1
				                            && [__仕入先] = k2
				                            && [__開始月] = lastRev
				                    ),
				                    [__単価]
				                )
				            RETURN
				                IF (
				                    NOT ISBLANK ( p ),
				                    FORMAT ( lastRev, "yyyymmdd" ) & "|"
				                        & FORMAT ( p, "000000000000.000000" )
				                )
				    )
				
				// 仕入先間の集約: 単純平均をやめ、最新改定の契約単価を採用
				VAR __ByMat0 =
				    GROUPBY (
				        __ComboPrice,
				        [__材料番号],
				        [__月],
				        "__selK", MAXX ( CURRENTGROUP (), [__適用K] )
				    )
				
				VAR __ByMat =
				    SELECTCOLUMNS (
				        FILTER ( __ByMat0, NOT ISBLANK ( [__selK] ) ),
				        "__材料番号", [__材料番号],
				        "__月",       [__月],
				        "__契約単価", VALUE ( MID ( [__selK], 10, 30 ) )
				    )
				
				VAR __WithPrev =
				    ADDCOLUMNS (
				        __ByMat,
				        "__前月単価",
				            VAR k = [__材料番号]
				            VAR pm = EDATE ( [__月], -1 )
				            RETURN
				                MAXX (
				                    FILTER ( __ByMat, [__材料番号] = k && [__月] = pm ),
				                    [__契約単価]
				                )
				    )
				
				VAR __QAgg =
				    // 稼働量は 材料_月次稼働量 に一本化した(同一計算の三重定義を解消)
				    SELECTCOLUMNS (
				        '材料_月次稼働量',
				        "__材料番号", '材料_月次稼働量'[F_材料番号] & "",
				        "__基準月",   EDATE ( '材料_月次稼働量'[F_開始月], 0 ),
				        "__稼働量",   '材料_月次稼働量'[直近12か月稼働量] * 1
				    )
				
				VAR __Final0 =
				    NATURALLEFTOUTERJOIN (
				        __WithPrev,
				        SELECTCOLUMNS ( __QAgg, "__材料番号", [__材料番号], "__月", [__基準月], "__稼働量", [__稼働量] )
				    )
				
				VAR __Final =
				    ADDCOLUMNS (
				        __Final0,
				        "__値上げ額",
				            IF (
				                NOT ISBLANK ( [__前月単価] ),
				                [__契約単価] - [__前月単価]
				            )
				    )
				
				VAR __Map0 =
				    SELECTCOLUMNS (
				        '材料情報',
				        "__材料番号",
				            TRIM (
				                SUBSTITUTE (
				                    '材料情報'[F_材料番号],
				                    UNICHAR ( 12288 ),
				                    " "
				                )
				            ) & "",
				        "__在k", '材料情報'[F_在庫材料番号] & ""
				    )
				
				VAR __Map =
				    GROUPBY (
				        __Map0,
				        [__材料番号],
				        "__在庫番号", MAXX ( CURRENTGROUP (), [__在k] )
				    )
				
				VAR __J2 =
				    NATURALLEFTOUTERJOIN ( __Final, __Map )
				
				RETURN
				    SELECTCOLUMNS (
				        __J2,
				        "F_在庫材料番号", [__在庫番号],
				        "F_材料番号",     [__材料番号],
				        "F_開始月",       [__月],
				        "契約単価",       [__契約単価],
				        "契約単価_前月契約単価",   [__前月単価],
				        "契約単価_値上げ額",       [__値上げ額],
				        "契約単価_値上げ率",       DIVIDE ( [__値上げ額], [__前月単価] ),
				        "契約単価_年間予測影響額", [__値上げ額] * [__稼働量],
				        "契約単価_年間予測影響額_値上げのみ",
				            IF ( [__値上げ額] > 0, [__値上げ額] * [__稼働量] ),
				        "契約単価_年間予測影響額_値下げのみ",
				            IF ( [__値上げ額] < 0, [__値上げ額] * [__稼働量] ),
				        "契約単価_直近12か月稼働量", [__稼働量]
				    )
				
				```

	annotation PBI_Id = e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0

