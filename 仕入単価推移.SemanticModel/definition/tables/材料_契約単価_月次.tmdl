table 材料_契約単価_月次
	lineageTag: e5f6a7b8-c9d0-4e12-3f4a-5b6c7d8e9f2c

	measure 材料使用有無_契約単価 =
			
			IF ( COUNTROWS ( '材料_契約単価_月次' ) > 0, 1, 0 )
		formatString: 0
		lineageTag: d2e3f4a5-b6c7-4389-0e1f-2a3b8c9d0e1f

	measure 月割年初来影響_材料契約 = DIVIDE ( SUM ( '材料_契約単価_月次'[契約単価_年初来影響額] ), 12 )
		formatString: #,0
		lineageTag: 9a2c4e6b-5d8f-4012-c3e5-0b7d9f1a2b3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 契約単価_年度基準比 =
			// 年度基準単価に対する当月契約単価の倍率。確認用の表示専用で、影響額の計算には使わない。
			DIVIDE (
			    SUM ( '材料_契約単価_月次'[契約単価] ),
			    SUM ( '材料_契約単価_月次'[契約単価_年度基準] )
			)
		formatString: #,0.00"倍"
		lineageTag: 8f1e2d3c-4b5a-4697-8071-2c3d4e5f6a71

	measure 契約_年初来影響額_最新実績月 =
			// 選択範囲の最終月。ただし仕入実績のある最終月を超えない。
			// 従来の実績側は選択範囲の最大月(=12月の見込)を返し、「直近実績月時点」の表示と食い違っていた。
			VAR __Actual = MAXX ( 'データ基準', 'データ基準'[最終仕入月] )
			VAR __Sel =
			    CALCULATE (
			        MAX ( '材料_契約単価_月次'[F_開始月] ),
			        ALLSELECTED ( '材料_契約単価_月次'[F_開始月] )
			    )
			VAR __M = MINX ( { __Actual, __Sel }, [Value] )
			RETURN
			    CALCULATE (
			        SUM ( '材料_契約単価_月次'[契約単価_年初来影響額] ),
			        '材料_契約単価_月次'[F_開始月] = __M
			    )
		formatString: #,0
		lineageTag: 3a1b2c3d-4e5f-4061-8172-9a0b1c2d3e01

	measure 契約_年初来影響額_値上げのみ =
			CALCULATE (
			    SUM ( '材料_契約単価_月次'[契約単価_年初来影響額] ),
			    '材料_契約単価_月次'[契約単価_年初来値上げ額] > 0
			)
		formatString: #,0
		lineageTag: 3a1b2c3d-4e5f-4061-8172-9a0b1c2d3e02

	measure 契約_年初来影響額_値下げのみ =
			CALCULATE (
			    SUM ( '材料_契約単価_月次'[契約単価_年初来影響額] ),
			    '材料_契約単価_月次'[契約単価_年初来値上げ額] < 0
			)
		formatString: #,0
		lineageTag: 3a1b2c3d-4e5f-4061-8172-9a0b1c2d3e03

	measure 契約_年初来値上げ率 =
			// 実績側の列「年初来値上げ率」(=年初来値上げ額÷年度基準単価)の平均に対応する契約側の値。
			AVERAGEX (
			    FILTER (
			        '材料_契約単価_月次',
			        NOT ISBLANK ( '材料_契約単価_月次'[契約単価_年度基準] )
			    ),
			    DIVIDE (
			        '材料_契約単価_月次'[契約単価_年初来値上げ額],
			        '材料_契約単価_月次'[契約単価_年度基準]
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a1b2c3d-4e5f-4061-8172-9a0b1c2d3e04

	measure 月割影響額差_契約実績 =
			// 正なら契約単価のほうが大きく動いている(納入未反映かマスタと実態の乖離)。
			// 負なら実績のほうが大きく動いている(年度基準の取り方の違いなど)。
			[月割年初来影響_材料契約] - [月割年初来影響_材料実績]
		formatString: #,0
		lineageTag: 3a1b2c3d-4e5f-4061-8172-9a0b1c2d3e05

	measure 月割影響額差_契約実績_絶対値 = ABS ( [月割影響額差_契約実績] )
		formatString: #,0
		lineageTag: 3a1b2c3d-4e5f-4061-8172-9a0b1c2d3e06

	measure 契約_年初単価 =
			// 明細の列見出しを読める名前にするためのメジャー。単価は加算しないので MAX を採る。
			MAX ( '材料_契約単価_月次'[契約単価_年度基準] )
		formatString: #,0.00
		lineageTag: 4b2c3d4e-5f60-4172-8283-9a0b1c2d3e11

	measure 契約_当月単価 = MAX ( '材料_契約単価_月次'[契約単価] )
		formatString: #,0.00
		lineageTag: 4b2c3d4e-5f60-4172-8283-9a0b1c2d3e12

	measure 稼働量_直近12か月 = SUM ( '材料_契約単価_月次'[契約単価_直近12か月稼働量] )
		formatString: #,0
		lineageTag: 4b2c3d4e-5f60-4172-8283-9a0b1c2d3e14

	measure 契約_年初来影響額_正味 =
			// 月チャートの折れ線用。値上げのみ(+)と値下げのみ(-)の積み上げでは
			// 正味がどこにあるか読めないため、同じ単位の線を重ねる。
			SUM ( '材料_契約単価_月次'[契約単価_年初来影響額] )
		formatString: #,0
		lineageTag: 5c3d4e5f-6071-4182-9394-ab1c2d3e4f31

	measure 材料_契約 =
			// 集計表の列見出しを短くするための表示専用メジャー。
			[月割年初来影響_材料契約]
		formatString: #,0
		lineageTag: 5c3d4e5f-6071-4182-9394-ab1c2d3e4f32

	measure 材料_値上げ =
			// エクセル No.5+6 の基準に合わせ、値上がりした材料だけを集計する。
			// 値下がりは No.11(部品購入原価低減)・No.12(VAVE)・No.14(中国電線導入)・
			// No.26(最適仕入先選択)が別項目として持っているため、ここに入れると二重計上になる。
			DIVIDE (
			    CALCULATE (
			        SUM ( '材料_契約単価_月次'[契約単価_年初来影響額] ),
			        '材料_契約単価_月次'[契約単価_年初来値上げ額] > 0
			    ),
			    12
			)
		formatString: #,0
		lineageTag: 6d4e5f60-7182-4293-a4b5-bc2d3e4f5a41

	measure 契約_月割値上げ_最新実績月 =
			// カード用。転記対象そのもの(値上がりのみ・月割)を直近実績月で表示する。
			VAR __Actual = MAXX ( 'データ基準', 'データ基準'[最終仕入月] )
			VAR __Sel =
			    CALCULATE (
			        MAX ( '材料_契約単価_月次'[F_開始月] ),
			        ALLSELECTED ( '材料_契約単価_月次'[F_開始月] )
			    )
			VAR __M = MINX ( { __Actual, __Sel }, [Value] )
			RETURN
			    CALCULATE ( [材料_値上げ], '材料_契約単価_月次'[F_開始月] = __M )
		formatString: #,0
		lineageTag: 6d4e5f60-7182-4293-a4b5-bc2d3e4f5a42

	measure 材料_値上げ_倍率2倍以上 =
			// 検知②用。転記額に効いていて、かつ年初比で2倍以上に跳ねた材料だけを返す。
			// 2倍未満は空白になりチャートから外れるが、集計表・カードの金額には一切影響しない。
			IF ( [契約単価_年度基準比] >= 2, [材料_値上げ] )
		formatString: #,0
		lineageTag: 7e5f6071-8293-43a4-b5c6-cd3e4f5a6b51

	measure 材料_値上げ_電線 =
			CALCULATE ( [材料_値上げ], '品目分類情報'[電線区分] = "電線" )
		formatString: #,0
		lineageTag: 8f607182-93a4-44b5-c6d7-de4f5a6b7c61

	measure 材料_値上げ_電線以外 =
			CALCULATE ( [材料_値上げ], '品目分類情報'[電線区分] = "電線以外" )
		formatString: #,0
		lineageTag: 8f607182-93a4-44b5-c6d7-de4f5a6b7c62

	column F_材料番号
