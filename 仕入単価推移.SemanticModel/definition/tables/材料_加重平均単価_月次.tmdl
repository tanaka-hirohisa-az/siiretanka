		lineageTag: f5e6f7a8-b9c0-4314-c536-e7f8a9b0c1de
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 年初来値上げ率 = DIVIDE ( [年初来値上げ額], [年度基準単価] )
		dataType: double
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f6f7a8b9-c0d1-4425-d647-f8a9b0c1d2ef
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition 材料_加重平均単価_月次 = calculated
		mode: import
		source =
				VAR __Ev0 =
				    FILTER (
				        'TB_仕入実績情報',
				        NOT ISBLANK ( 'TB_仕入実績情報'[F_品目番号] )
				            && NOT ISBLANK ( 'TB_仕入実績情報'[F_仕入日] )
				            && 'TB_仕入実績情報'[F_仕入数] > 0
				    )
				
				VAR __Ev =
				    SELECTCOLUMNS (
				        __Ev0,
				        "__材料番号",
				            TRIM (
				                SUBSTITUTE (
				                    'TB_仕入実績情報'[F_品目番号],
				                    UNICHAR ( 12288 ),
				                    " "
				                )
				            ) & "",
				        "__月",
				            EOMONTH ( DATEVALUE ( 'TB_仕入実績情報'[F_仕入日] ), -1 ) + 1,
				        "__数", 'TB_仕入実績情報'[F_仕入数],
				        "__額", 'TB_仕入実績情報'[F_仕入数] * 'TB_仕入実績情報'[F_単価]
				    )
				
				VAR __MatSet =
				    FILTER (
				        DISTINCT (
				            SELECTCOLUMNS (
				                '材料情報',
				                "__材料番号",
				                    TRIM (
				                        SUBSTITUTE (
				                            '材料情報'[F_材料番号],
				                            UNICHAR ( 12288 ),
				                            " "
				                        )
				                    ) & ""
				            )
				        ),
				        [__材料番号] <> ""
				    )
				
				VAR __EvM =
				    NATURALINNERJOIN ( __Ev, __MatSet )
				
				VAR __M =
				    GROUPBY (
				        __EvM,
				        [__材料番号],
				        [__月],
				        "__月数計", SUMX ( CURRENTGROUP (), [__数] ),
				        "__月額計", SUMX ( CURRENTGROUP (), [__額] )
				    )
				
				// 【スパイン】仕入のあった月から、その年の12月まで行を作る。
				// 旧: 仕入月+5ヶ月の窓、かつ「その材料の最終仕入月」で打ち切っていた。
				//     そのため3月に最後に買った材料は4月以降レポートから消え、値上がりが続いて
				//     いるのに影響額がゼロになっていた。年初来影響額は一度積み上がれば年内は
				//     残る性質の数字であり、打ち切りは誤り。
				// 新: 各仕入月を同一暦年内の12月まで前方展開する。年をまたぐ引き継ぎはしない
				//     (年初来影響額は YEAR() で暦年リセットするため)。
				//
				// 【単価】重なった月は「最も新しい仕入月」の実単価を採る。
				// 旧は窓内の数量・金額を合計して割る6ヶ月移動平均で、値上がり局面では当月価格を
				// 下回り値上げ額が過小になっていた(実測: エクセル比 電線0.60倍・電線以外0.30倍)。
				// 例) ES2000-NO.2-B9-0-STK は 2026/02 に 135円→864円 だが 6ヶ月平均では226円。
				VAR __ShiftBase =
				    SELECTCOLUMNS (
				        CROSSJOIN (
				            __M,
				            SELECTCOLUMNS ( GENERATESERIES ( 0, 11, 1 ), "__k", [Value] )
				        ),
				        "__材料番号", [__材料番号],
				        "__購入月",   [__月],
				        "__基準月",   EDATE ( [__月], [__k] ),
				        "__数c",      [__月数計],
				        "__額c",      [__月額計]
				    )
				
				// 同一暦年内に限定する
				VAR __Shift =
				    FILTER ( __ShiftBase, YEAR ( [__基準月] ) = YEAR ( [__購入月] ) )
				
				VAR __Agg0a =
				    GROUPBY (
				        __Shift,
				        [__材料番号],
				        [__基準月],
				        "__数計",   SUMX ( CURRENTGROUP (), [__数c] ),
				        "__額計",   SUMX ( CURRENTGROUP (), [__額c] ),
				        "__仕入月", MAXX ( CURRENTGROUP (), [__購入月] )
				    )
				
				// 仕入月ごとの実単価（月内金額 ÷ 月内数量）
				VAR __PriceByMonth =
				    SELECTCOLUMNS (
				        __M,
				        "__材料番号", [__材料番号],
				        "__仕入月",   [__月],
				        "__当月単価", DIVIDE ( [__月額計], [__月数計] )
				    )
				
				VAR __Agg0 =
				    NATURALLEFTOUTERJOIN ( __Agg0a, __PriceByMonth )
				
				// 稼働量の窓：年間予測影響額用に直近12ヶ月を維持
				VAR __Agg12 =
				    // 稼働量は 材料_月次稼働量 に一本化した(同一計算の三重定義を解消)
				    SELECTCOLUMNS (
				        '材料_月次稼働量',
				        "__材料番号", '材料_月次稼働量'[F_材料番号] & "",
				        "__基準月",   EDATE ( '材料_月次稼働量'[F_開始月], 0 ),
				        "__稼働量",   '材料_月次稼働量'[直近12か月稼働量] * 1
				    )
				
				VAR __Mats =
				    GROUPBY (
				        __M,
				        [__材料番号],
				        "__終月", MAXX ( CURRENTGROUP (), [__月] )
				    )
				
				// 最終仕入月での打ち切りは廃止した(スパインのコメント参照)
				VAR __Agg =
				    ADDCOLUMNS (
				        FILTER ( __Agg0, [__数計] > 0 ),
				        "__加重平均単価", [__当月単価]
				    )
				
				VAR __PrevT =
				    SELECTCOLUMNS (
				        __Agg,
				        "__材料番号", [__材料番号],
				        "__基準月",   EDATE ( [__基準月], 1 ),
				        "__前月単価", [__加重平均単価]
				    )
				
				VAR __Cur =
				    SELECTCOLUMNS (
				        __M,
				        "__材料番号", [__材料番号],
				        "__基準月",   [__月],
				        "__月内数",   [__月数計],
				        "__月内額",   [__月額計]
				    )
				
				VAR __J =
				    NATURALLEFTOUTERJOIN (
				        NATURALLEFTOUTERJOIN (
				            NATURALLEFTOUTERJOIN ( __Agg, __PrevT ),
				            __Cur
				        ),
				        __Agg12
				    )
				
				// 前回加重平均単価：
				//   通常は前月時点の6ヶ月加重平均。
				//   前月に窓内仕入がない場合（6ヶ月超の空白明け）は、
				//   それ以前で最も近い仕入月の月内加重平均にフォールバックする。
				VAR __Final =
				    ADDCOLUMNS (
				        __J,
				        "__前回単価",
				            IF (
				                NOT ISBLANK ( [__前月単価] ),
				                [__前月単価],
				                VAR __mat = [__材料番号]
				                VAR __bm  = [__基準月]
				                VAR __pm =
				                    MAXX (
				                        FILTER ( __M, [__材料番号] = __mat && [__月] < __bm ),
				                        [__月]
				                    )
				                RETURN
				                    IF (
				                        NOT ISBLANK ( __pm ),
				                        MAXX (
				                            FILTER ( __M, [__材料番号] = __mat && [__月] = __pm ),
				                            DIVIDE ( [__月額計], [__月数計] )
				                        )
				                    )
				            )
				    )
				
				VAR __Final2 =
				    ADDCOLUMNS (
				        __Final,
				        "__値上げ額",
				            IF (
				                NOT ISBLANK ( [__前回単価] ),
				                [__加重平均単価] - [__前回単価]
				            )
				    )
				
				VAR __Map0 =
				    SELECTCOLUMNS (
				        '材料情報',
				        "__材料番号",
				            TRIM (
				                SUBSTITUTE (
				                    '材料情報'[F_材料番号],
				                    UNICHAR ( 12288 ),
				                    " "
				                )
				            ) & "",
				        "__在k", '材料情報'[F_在庫材料番号] & ""
				    )
				
				VAR __Map =
				    GROUPBY (
				        __Map0,
				        [__材料番号],
				        "__在庫番号", MAXX ( CURRENTGROUP (), [__在k] )
				    )
				
				VAR __J2 =
				    NATURALLEFTOUTERJOIN ( __Final2, __Map )
				
				RETURN
				    SELECTCOLUMNS (
				        __J2,
				        "F_在庫材料番号", [__在庫番号],
				        "F_材料番号",     [__材料番号],
				        "F_開始月",       [__基準月],
				        "加重平均単価",   [__加重平均単価],
				        "前回加重平均単価", [__前回単価],
				        "月内仕入数",     [__月内数],
				        "月内仕入金額",   [__月内額],
				        "値上げ額",       [__値上げ額],
				        "値上げ率",       DIVIDE ( [__値上げ額], [__前回単価] ),
				        "年間予測影響額", [__値上げ額] * [__稼働量],
				        "年間予測影響額_値上げのみ",
				            IF ( [__値上げ額] > 0, [__値上げ額] * [__稼働量] ),
				        "年間予測影響額_値下げのみ",
				            IF ( [__値上げ額] < 0, [__値上げ額] * [__稼働量] ),
				        "直近12か月稼働量", [__稼働量]
				    )

	annotation PBI_Id = d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9

