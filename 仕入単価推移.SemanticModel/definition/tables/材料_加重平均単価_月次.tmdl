	column 年度基準単価 =
			// 年初(1月)に行が無い材料も対象に含めるため、
			// 「その年の最初の行」の前回加重平均単価を年度基準とする
			// (1月行がある材料は従来と同値)
			VAR __mat = '材料_加重平均単価_月次'[F_材料番号]
			VAR __y = YEAR ( '材料_加重平均単価_月次'[F_開始月] )
			VAR __firstM =
			    MINX (
			        FILTER (
			            '材料_加重平均単価_月次',
			            '材料_加重平均単価_月次'[F_材料番号] = __mat
			                && YEAR ( '材料_加重平均単価_月次'[F_開始月] ) = __y
			        ),
			        '材料_加重平均単価_月次'[F_開始月]
			    )
			RETURN
			    LOOKUPVALUE (
			        '材料_加重平均単価_月次'[前回加重平均単価],
			        '材料_加重平均単価_月次'[F_材料番号], __mat,
			        '材料_加重平均単価_月次'[F_開始月], __firstM
			    )
		dataType: double
		formatString: #,0.00
		lineageTag: f1a2b3c4-d5e6-4f70-8192-a3b4c5d6e7fa
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 年初来値上げ額 = IF ( NOT ISBLANK ( [年度基準単価] ), [加重平均単価] - [年度基準単価] )
		dataType: double
		formatString: #,0.00
		lineageTag: f2b3c4d5-e6f7-4081-9203-b4c5d6e7f8ab
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 年初来影響額 = IF ( NOT ISBLANK ( [年初来値上げ額] ), [年初来値上げ額] * [直近12か月稼働量] )
		dataType: double
		formatString: #,0.00
		lineageTag: f3c4d5e6-f7a8-4192-a314-c5d6e7f8a9bc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 年初来影響額_値上げのみ = IF ( [年初来値上げ額] > 0, [年初来影響額] )
