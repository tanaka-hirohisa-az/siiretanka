		lineageTag: f4d5e6f7-a8b9-4203-b425-d6e7f8a9b0cd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 年初来影響額_値下げのみ = IF ( [年初来値上げ額] < 0, [年初来影響額] )
		dataType: double
