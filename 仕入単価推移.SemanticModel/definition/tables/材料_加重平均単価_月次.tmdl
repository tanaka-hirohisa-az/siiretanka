table 材料_加重平均単価_月次
	lineageTag: d4e5f6a7-b8c9-4d01-2e3f-4a5b6c7d8e9a

	measure 材料使用有無_加重平均 =
			
			IF ( COUNTROWS ( '材料_加重平均単価_月次' ) > 0, 1, 0 )
		formatString: 0
		lineageTag: c1d2e3f4-a5b6-4278-9d0e-1f2a7b8c9d0e

	measure 月割年初来影響_材料実績 = DIVIDE ( SUM ( '材料_加重平均単価_月次'[年初来影響額] ), 12 )
		formatString: #,0
		lineageTag: 6c2e8a4f-1d9b-4356-a7c3-2f5e8b9d0a1c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 年初来影響額_最新月 = ```
			
			VAR __LatestMonth =
			    CALCULATE (
			        MAX ( '材料_加重平均単価_月次'[F_開始月] ),
			        ALLSELECTED ( '材料_加重平均単価_月次'[F_開始月] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( '材料_加重平均単価_月次'[年初来影響額] ),
			        '材料_加重平均単価_月次'[F_開始月] = __LatestMonth
			    )
			
			```
		formatString: #,0.00
		lineageTag: 7d3f9a1c-2b6e-4f80-9c1a-5e8d2f4b6a9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 年間予測影響額_最新月 = ```
			
			VAR __LatestMonth =
			    CALCULATE (
			        MAX ( '材料_加重平均単価_月次'[F_開始月] ),
			        ALLSELECTED ( '材料_加重平均単価_月次'[F_開始月] )
			    )
			RETURN
			    CALCULATE (
			        SUM ( '材料_加重平均単価_月次'[年間予測影響額] ),
			        '材料_加重平均単価_月次'[F_開始月] = __LatestMonth
			    )
			
			```
		formatString: #,0.00
		lineageTag: 9e4a2c1b-3d7f-4890-a1b2-6c3e5f7a8b9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 実績単価_年度基準比 =
			// 年度基準単価に対する当月実績単価の倍率。確認用の表示専用で、影響額の計算には使わない。
			DIVIDE (
			    SUM ( '材料_加重平均単価_月次'[加重平均単価] ),
			    SUM ( '材料_加重平均単価_月次'[年度基準単価] )
			)
		formatString: #,0.00"倍"
		lineageTag: 8f1e2d3c-4b5a-4697-8071-2c3d4e5f6a72

	measure 実績_年初単価 = MAX ( '材料_加重平均単価_月次'[年度基準単価] )
