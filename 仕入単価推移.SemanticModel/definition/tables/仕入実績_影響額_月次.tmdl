/// 仕入実績(PRONES.TB_仕入実績情報)から算出した値上げ影響額。参照エクセルと同一定義。
/// 影響額＝(当月単価−基準単価)×その月の仕入数量。単価＝金額÷数量。
/// 単価は材料×仕入先×月で算出し、倉庫は数量の分解軸。倉庫を合算すると参照エクセルの値に戻る。
/// 基準単価＝2025年の最終月の単価。2025年に実績がない場合は2026年の最初の月の単価(基準区分で判別)。
/// 異常値区分は除外そのものではなく判定結果の保持。スライサで対象範囲を制御する。
table 仕入実績_影響額_月次
	lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c3d4

	measure 影響額_合計 =
			SUM ( '仕入実績_影響額_月次'[影響額] )
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c101

	measure 影響額_値上げのみ =
			// 転記対象。エクセル No.5/6 は値上がり分のみを記録する。
			CALCULATE (
			    SUM ( '仕入実績_影響額_月次'[影響額] ),
			    '仕入実績_影響額_月次'[単価差] > 0
			)
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c102

	measure 影響額_値下げのみ =
			CALCULATE (
			    SUM ( '仕入実績_影響額_月次'[影響額] ),
			    '仕入実績_影響額_月次'[単価差] < 0
			)
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c103

	measure 転記額 =
			// 集計表(Excel転記用)専用。エクセルは利益への影響で記録するため符号を反転する。
			-[影響額_値上げのみ]
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c104

	measure 仕入額_合計 =
			SUM ( '仕入実績_影響額_月次'[仕入額] )
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c105

	measure 値上げ率 =
			// 仕入額に対する値上げ影響の比率。仕入先別の突出を検知する。
			DIVIDE ( [影響額_値上げのみ], [仕入額_合計] )
		formatString: 0.0%
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c106

	measure 純影響額 =
			[影響額_値上げのみ] + [影響額_値下げのみ]
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c107

	column 年月
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c200
		summarizeBy: none
		sourceColumn: 年月

		annotation SummarizationSetBy = Automatic

	column 年月日
		dataType: dateTime
		formatString: yyyy/mm
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c201
		summarizeBy: none
		sourceColumn: 年月日

		annotation SummarizationSetBy = Automatic

	column 材料番号
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c202
		summarizeBy: none
		sourceColumn: 材料番号

		annotation SummarizationSetBy = Automatic

	column 仕入先番号
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c203
		summarizeBy: none
		sourceColumn: 仕入先番号

		annotation SummarizationSetBy = Automatic

	column 倉庫番号
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c204
		summarizeBy: none
		sourceColumn: 倉庫番号

		annotation SummarizationSetBy = Automatic

	column 基準単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c205
		summarizeBy: none
		sourceColumn: 基準単価

		annotation SummarizationSetBy = Automatic

	column 当月単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c206
		summarizeBy: none
		sourceColumn: 当月単価

		annotation SummarizationSetBy = Automatic

	column 単価差
		dataType: double
		formatString: #,0.000000
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c207
		summarizeBy: none
		sourceColumn: 単価差

		annotation SummarizationSetBy = Automatic

	column 数量
		dataType: double
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c208
		summarizeBy: none
		sourceColumn: 数量

		annotation SummarizationSetBy = Automatic

	column 仕入額
		dataType: double
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c209
		summarizeBy: none
		sourceColumn: 仕入額

		annotation SummarizationSetBy = Automatic

	column 影響額
		dataType: double
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c210
		summarizeBy: none
		sourceColumn: 影響額

		annotation SummarizationSetBy = Automatic

	column 異常値区分
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c211
		summarizeBy: none
		sourceColumn: 異常値区分

		annotation SummarizationSetBy = Automatic

	column 基準区分
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c212
		summarizeBy: none
		sourceColumn: 基準区分

		annotation SummarizationSetBy = Automatic

	column 基準年月
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c213
		summarizeBy: none
		sourceColumn: 基準年月

		annotation SummarizationSetBy = Automatic

	partition 仕入実績_影響額_月次 = m
		mode: import
		source =
				let
				    ソース = Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"),
				    結果 = Value.NativeQuery(ソース, "WITH w AS (SELECT TRIM(F_品目番号) AS mat, TRIM(F_指示先番号) AS sup, TRIM(F_在庫場所) AS wh, F_勘定年月 AS ym, SUM(F_仕入数) AS q, SUM(F_金額) AS amt FROM PRONES.TB_仕入実績情報 WHERE F_勘定年月 >= '2025/01' AND NVL(F_仕入数,0)<>0 AND NVL(F_金額,0)<>0 GROUP BY TRIM(F_品目番号), TRIM(F_指示先番号), TRIM(F_在庫場所), F_勘定年月), wm AS (SELECT w.*, SUM(q) OVER (PARTITION BY mat, sup, ym) AS mq, SUM(amt) OVER (PARTITION BY mat, sup, ym) AS mamt FROM w), mo AS (SELECT DISTINCT mat, sup, ym, mq, mamt, mamt/mq AS upx FROM wm WHERE mq<>0 AND mamt<>0), b AS (SELECT mat, sup, NVL(MAX(CASE WHEN ym LIKE '2025%' THEN ym END), MIN(ym)) AS bym, COUNT(CASE WHEN ym LIKE '2025%' THEN 1 END) AS mc25, CASE WHEN MAX(CASE WHEN ym LIKE '2025%' THEN ym END) IS NOT NULL THEN '前年最終月' ELSE '当年初回' END AS bkind FROM mo GROUP BY mat, sup), bx AS (SELECT b.mat, b.sup, b.bym, b.bkind, b.mc25, p.upx AS bpx, p.mq AS bq FROM b JOIN mo p ON p.mat=b.mat AND p.sup=b.sup AND p.ym=b.bym) SELECT x.ym AS 年月, TO_DATE(x.ym||'/01','YYYY/MM/DD') AS 年月日, x.mat AS 材料番号, x.sup AS 仕入先番号, x.wh AS 倉庫番号, ROUND(bx.bpx,6) AS 基準単価, ROUND(x.mamt/x.mq,6) AS 当月単価, ROUND(x.mamt/x.mq - bx.bpx,6) AS 単価差, x.q AS 数量, x.amt AS 仕入額, ROUND((x.mamt/x.mq - bx.bpx)*x.q,2) AS 影響額, CASE WHEN bx.mc25=1 AND bx.bkind='前年最終月' AND bx.bq<5 THEN '試作基準' WHEN x.mamt/x.mq > bx.bpx*3 OR x.mamt/x.mq < bx.bpx/3 THEN '比率乖離' ELSE '対象' END AS 異常値区分, bx.bkind AS 基準区分, bx.bym AS 基準年月 FROM wm x JOIN bx ON bx.mat=x.mat AND bx.sup=x.sup WHERE x.ym >= '2026/01' AND x.mq<>0 AND bx.bpx<>0")
				in
				    結果

	annotation PBI_ResultType = Table
