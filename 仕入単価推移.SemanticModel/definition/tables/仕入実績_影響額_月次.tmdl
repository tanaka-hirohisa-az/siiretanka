/// 仕入実績(PRONES.TB_仕入実績情報)から算出した値上げ影響額。参照エクセルと同一定義。
/// 影響額＝(当月単価−基準単価)×その月の仕入数量。単価＝金額÷数量。
/// 単価は材料×仕入先×月で算出し、倉庫は数量の分解軸。倉庫を合算すると参照エクセルの値に戻る。
/// 基準単価＝2025年の最終月の単価。2025年に実績がない場合は2026年の最初の月の単価(基準区分で判別)。
/// 異常値区分は除外そのものではなく判定結果の保持。スライサで対象範囲を制御する。
table 仕入実績_影響額_月次
	lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c3d4

	measure 影響額_合計 = SUM ( '仕入実績_影響額_月次'[影響額] )
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c101

	measure 影響額_値上げのみ =
			// エクセル No.5/6 に記録するのは値上がり分のみ。
			CALCULATE (
			    SUM ( '仕入実績_影響額_月次'[影響額] ),
			    '仕入実績_影響額_月次'[単価差] > 0
			)
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c102

	measure 影響額_値下げのみ =
			CALCULATE (
			    SUM ( '仕入実績_影響額_月次'[影響額] ),
			    '仕入実績_影響額_月次'[単価差] < 0
			)
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c103

	measure PLヒット額_値上げ分 =
			// 集計表専用。◎PLヒット案件まとめ は利益への影響で記録するため符号を反転する。
			-[影響額_値上げのみ]
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c104

	measure 仕入額_合計 = SUM ( '仕入実績_影響額_月次'[仕入額] )
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c105

	measure 値上げ率 =
			// 仕入額に対する値上げ影響の比率。仕入先別の突出を検知する。
			DIVIDE ( [影響額_値上げのみ], [仕入額_合計] )
		formatString: 0.0%
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c106

	measure 影響額_純額 = [影響額_値上げのみ] + [影響額_値下げのみ]
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c107

	measure PLヒット額_値上げ分_選択最終月 =
			// カード用。選択している年月のうち最終月のみを集計する。
			// 実績月に限定していないので、見込月が選択範囲に入っていればその月を表示する。
			VAR __Sel =
			    CALCULATE (
			        MAX ( '仕入実績_影響額_月次'[年月] ),
			        ALLSELECTED ( '仕入実績_影響額_月次'[年月] )
			    )
			RETURN
			    CALCULATE ( -[影響額_値上げのみ], '仕入実績_影響額_月次'[年月] = __Sel )
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c108

	measure PLヒット額_純額 =
			// 集計表専用。値上がりと値下がりの純額を PLヒット額_値上げ分 と同じ符号規則(利益への影響)で出す。
			// 行に 改定方向 を置くと、値上げ行=値上げ分(負)・値下げ行=値下げ分(正)・総計=純額になる。
			-[影響額_純額]
		formatString: #,0
		lineageTag: b0fbcdc6-4f95-4260-bf56-3575afa8bba9

	measure 仕入額比 =
			// 集計表専用。その行の影響額が、同じ電線区分・仕向け区分・月の仕入総額の何%かを出す。
			// 分母は改定方向を外して数える。外さないと値上げ行の分母が「値上がりした材料の仕入額」に縮み、
			// 総額に対する割合にならない。分母は値上がり・値下がり・変動なしをすべて含む。
			// 符号は仕入側(値上げ=正・値下げ=負)。分母の仕入総額が仕入側の金額なので分子もそろえる。
			// 隣の PLヒット額_純額 は利益側(値上げ=負)で逆向きだが、両方を正にすると値上げ行と値下げ行の
			// 割合を足しても総計(純額)に合わなくなるため、仕入側の符号で通す。
			// 部材区分・単価判定などのスライサは分母にも効く。
			DIVIDE (
			    [影響額_純額],
			    CALCULATE (
			        [仕入額_合計],
			        REMOVEFILTERS ( '仕入実績_影響額_月次'[改定方向], '仕入実績_影響額_月次'[改定方向_順] )
			    )
			)
		formatString: 0.0%
		lineageTag: dca3e6f0-b8a9-4f5f-8148-0fdae4f9b87e

	column 年月
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c200
		summarizeBy: none
		sourceColumn: 年月

		annotation SummarizationSetBy = Automatic

	column 年月日
		dataType: dateTime
		formatString: yyyy/mm
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c201
		summarizeBy: none
		sourceColumn: 年月日

		annotation SummarizationSetBy = Automatic

	column 材料番号
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c202
		summarizeBy: none
		sourceColumn: 材料番号

		annotation SummarizationSetBy = Automatic

	column 仕入先番号
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c203
		summarizeBy: none
		sourceColumn: 仕入先番号

		annotation SummarizationSetBy = Automatic

	column 倉庫番号
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c204
		summarizeBy: none
		sourceColumn: 倉庫番号

		annotation SummarizationSetBy = Automatic

	column 基準単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c205
		summarizeBy: none
		sourceColumn: 基準単価

		annotation SummarizationSetBy = Automatic

	column 当月単価
		dataType: double
		formatString: #,0.000000
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c206
		summarizeBy: none
		sourceColumn: 当月単価

		annotation SummarizationSetBy = Automatic

	column 単価差
		dataType: double
		formatString: #,0.000000
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c207
		summarizeBy: none
		sourceColumn: 単価差

		annotation SummarizationSetBy = Automatic

	column 数量
		dataType: double
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c208
		summarizeBy: none
		sourceColumn: 数量

		annotation SummarizationSetBy = Automatic

	column 仕入額
		dataType: double
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c209
		summarizeBy: none
		sourceColumn: 仕入額

		annotation SummarizationSetBy = Automatic

	column 影響額
		dataType: double
		formatString: #,0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c210
		summarizeBy: none
		sourceColumn: 影響額

		annotation SummarizationSetBy = Automatic

	column 単価判定
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c211
		summarizeBy: none
		sourceColumn: 異常値区分
		sortByColumn: 単価判定_順

		annotation SummarizationSetBy = Automatic

	column 基準区分
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c212
		summarizeBy: none
		sourceColumn: 基準区分

		annotation SummarizationSetBy = Automatic

	column 基準年月
		dataType: string
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c213
		summarizeBy: none
		sourceColumn: 基準年月

		annotation SummarizationSetBy = Automatic

	column 単価判定_順
		dataType: double
		isHidden
		formatString: 0
		lineageTag: 5f607182-93a4-45b6-c7d8-e9f0a1b2c2a1
		summarizeBy: sum
		sourceColumn: 異常値区分_順

		annotation SummarizationSetBy = Automatic

	column 改定方向 =
			// 影響額_値上げのみ／値下げのみ と同じく単価差の符号で分ける。単価差は材料×仕入先×月で決まるので倉庫の行で割れない。
			SWITCH (
			    TRUE (),
			    '仕入実績_影響額_月次'[単価差] > 0, "値上げ",
			    '仕入実績_影響額_月次'[単価差] < 0, "値下げ",
			    "変動なし"
			)
		dataType: string
		lineageTag: 61837f9b-c901-42b0-a5b4-92d1c8a21e02
		summarizeBy: none
		sortByColumn: 改定方向_順

		annotation SummarizationSetBy = Automatic

	column 改定方向_順 =
			// 改定方向の並び順。値上げを上にする。
			SWITCH (
			    TRUE (),
			    '仕入実績_影響額_月次'[単価差] > 0, 1,
			    '仕入実績_影響額_月次'[単価差] < 0, 2,
			    3
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0f330a3a-c2d4-45e5-affe-6dafa9894e34
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 仕入実績_影響額_月次 = m
		mode: import
		source =
				let
				    ソース = Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"),
				    結果 = Value.NativeQuery(ソース, "WITH w AS (SELECT TRIM(F_品目番号) AS mat, TRIM(F_指示先番号) AS sup, TRIM(F_在庫場所) AS wh, F_勘定年月 AS ym, SUM(F_仕入数) AS q, SUM(F_金額) AS amt FROM PRONES.TB_仕入実績情報 WHERE F_勘定年月 >= '2025/01' AND NVL(F_仕入数,0)<>0 AND NVL(F_金額,0)<>0 GROUP BY TRIM(F_品目番号), TRIM(F_指示先番号), TRIM(F_在庫場所), F_勘定年月), wm AS (SELECT w.*, SUM(q) OVER (PARTITION BY mat, sup, ym) AS mq, SUM(amt) OVER (PARTITION BY mat, sup, ym) AS mamt FROM w), mo AS (SELECT DISTINCT mat, sup, ym, mq, mamt, mamt/mq AS upx FROM wm WHERE mq<>0 AND mamt<>0), b AS (SELECT mat, sup, NVL(MAX(CASE WHEN ym LIKE '2025%' THEN ym END), MIN(ym)) AS bym, COUNT(CASE WHEN ym LIKE '2025%' THEN 1 END) AS mc25, CASE WHEN MAX(CASE WHEN ym LIKE '2025%' THEN ym END) IS NOT NULL THEN '前年最終月' ELSE '当年初回' END AS bkind FROM mo GROUP BY mat, sup), bx AS (SELECT b.mat, b.sup, b.bym, b.bkind, b.mc25, p.upx AS bpx, p.mq AS bq FROM b JOIN mo p ON p.mat=b.mat AND p.sup=b.sup AND p.ym=b.bym) SELECT x.ym AS 年月, TO_DATE(x.ym||'/01','YYYY/MM/DD') AS 年月日, x.mat AS 材料番号, x.sup AS 仕入先番号, x.wh AS 倉庫番号, ROUND(bx.bpx,6) AS 基準単価, ROUND(x.mamt/x.mq,6) AS 当月単価, ROUND(x.mamt/x.mq - bx.bpx,6) AS 単価差, x.q AS 数量, x.amt AS 仕入額, ROUND((x.mamt/x.mq - bx.bpx)*x.q,2) AS 影響額, CASE WHEN bx.mc25=1 AND bx.bkind='前年最終月' AND bx.bq<5 THEN 'スポット(5個未満)' WHEN x.mamt/x.mq > bx.bpx*3 OR x.mamt/x.mq < bx.bpx/3 THEN '基準比3倍超・1/3未満' ELSE '正常' END AS 異常値区分, CASE WHEN bx.mc25=1 AND bx.bkind='前年最終月' AND bx.bq<5 THEN 3 WHEN x.mamt/x.mq > bx.bpx*3 OR x.mamt/x.mq < bx.bpx/3 THEN 2 ELSE 1 END AS 異常値区分_順, bx.bkind AS 基準区分, bx.bym AS 基準年月 FROM wm x JOIN bx ON bx.mat=x.mat AND bx.sup=x.sup WHERE x.ym >= '2026/01' AND x.mq<>0 AND bx.bpx<>0")
				in
				    結果

	annotation PBI_ResultType = Table

