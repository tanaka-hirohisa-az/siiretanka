table 材料_仕入単価履歴
	lineageTag: 1082d04a-de8f-4bbf-832c-b825d2b29920

	measure 履歴_前単価 =
			// 表示用。その行の直前の単価。
			// 前回単価(同一仕入先の直前)があればそれ。無い場合＝その仕入先で初回の登録なので、
			// 仕入先を問わずその材料の直前の契約単価を採る。仕入先の追加・切替でも
			// 材料としていくらから変わったのかが読めるようにするため。
			// 計算列にすると236,128行の自己走査になるため、表示行だけで評価されるメジャーにしている。
			VAR __empty = ISEMPTY ( '材料_仕入単価履歴' )
			VAR __own = MAX ( '材料_仕入単価履歴'[前回単価] )
			VAR __key = MAX ( '材料_仕入単価履歴'[F_材料番号] )
			VAR __date = MAX ( '材料_仕入単価履歴'[F_開始日] )
			VAR __prevDate =
			    MAXX (
			        FILTER (
			            ALL ( '材料_仕入単価履歴' ),
			            '材料_仕入単価履歴'[F_材料番号] = __key
			                && '材料_仕入単価履歴'[F_開始日] < __date
			        ),
			        '材料_仕入単価履歴'[F_開始日]
			    )
			VAR __matPrev =
			    MAXX (
			        FILTER (
			            ALL ( '材料_仕入単価履歴' ),
			            '材料_仕入単価履歴'[F_材料番号] = __key
			                && '材料_仕入単価履歴'[F_開始日] = __prevDate
			        ),
			        '材料_仕入単価履歴'[F_契約単価]
			    )
			RETURN
			    IF ( NOT __empty, COALESCE ( __own, __matPrev ) )
		formatString: #,0.00
		lineageTag: 9a1b2c3d-4e5f-4607-8192-a3b4c5d6e7f3

	measure 履歴_区分 =
			// 材料単位で判定する。
			//   新規登録  : その材料として初めて単価が登録された行
			//   仕入先追加: 別の仕入先が新たに登録された行(材料としては既に単価がある)
			//   値上げ/値下げ/変更なし : 同一仕入先による改定
			// 該当行が0件のときは必ず空白を返すこと。値を返すとテーブルビジュアルが
			// 存在しない組み合わせまで行として表示する。
			VAR __empty = ISEMPTY ( '材料_仕入単価履歴' )
			VAR __own = MAX ( '材料_仕入単価履歴'[前回単価] )
			VAR __prev = [履歴_前単価]
			VAR __cur = MAX ( '材料_仕入単価履歴'[F_契約単価] )
			RETURN
			    IF (
			        NOT __empty,
			        SWITCH (
			            TRUE (),
			            ISBLANK ( __prev ), "新規登録",
			            ISBLANK ( __own ), "仕入先追加",
			            __cur > __prev, "値上げ",
			            __cur < __prev, "値下げ",
			            "変更なし"
			        )
			    )
		lineageTag: 9a1b2c3d-4e5f-4607-8192-a3b4c5d6e7f1

	measure 履歴_単価差 =
			VAR __prev = [履歴_前単価]
			VAR __cur = MAX ( '材料_仕入単価履歴'[F_契約単価] )
			RETURN
			    IF ( NOT ISBLANK ( __prev ), __cur - __prev )
		formatString: #,0.00
		lineageTag: 9a1b2c3d-4e5f-4607-8192-a3b4c5d6e7f4

	measure 履歴_値上げ率 =
			DIVIDE ( [履歴_単価差], [履歴_前単価] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a1b2c3d-4e5f-4607-8192-a3b4c5d6e7f2

